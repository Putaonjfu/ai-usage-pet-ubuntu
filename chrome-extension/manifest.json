{
  "manifest_version": 3,
  "name": "AI Usage Pet · OpenAI 余额",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "读取用户确认的 OpenAI 余额页，将金额同步给本机桌面浮条。",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://platform.openai.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "连接桌面余额浮条"}
}
